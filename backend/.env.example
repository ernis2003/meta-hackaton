ACCESS_TOKEN_EXPIRE_MINUTES=5
# Generate a private value: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
DATABASE_PATH=./src/database/migrations/app.sqlite3
# Build once with actions/build_zeek_ja4_windows.bat before using this image.
ZEEK_MODE=docker
ZEEK_DOCKER_IMAGE=forensics-zeek-ja4:local
ZEEK_SCRIPTS=ja4
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Demo
ADMIN_SURNAME=Admin

# Optional local AI; training is always a separate terminal process.
AI_RUNTIME=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b-instruct-q4_K_M
AI_REQUIRE_FINE_TUNED=false
# For explicit Transformers+PEFT inference:
# AI_RUNTIME=transformers
# AI_SERVICE_URL=http://127.0.0.1:8002
# AI_ADAPTER_PATH=./src/ai/checkpoints/train/adapter

# Independent Meta Model API review. Never expose these variables to Vite.
MODEL_API_KEY=
META_MUSE_MODEL=muse-spark-1.3
META_MUSE_BASE_URL=https://api.meta.ai/v1
META_MUSE_MAX_TOOL_CALLS=4

