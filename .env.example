# Optional Docker Compose settings. Copy to .env; never commit the real file.
APP_PORT=8080

# Leave blank to generate a private key persisted in the forensic_data volume.
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional initial administrator. Otherwise sign up and use manage.py make-admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
ADMIN_SURNAME=Account

# Optional GPU profile: actual trained adapter and approved gated model access.
LLAMA_ADAPTER_PATH=./backend/src/ai/checkpoints/train/adapter
HF_TOKEN=
# Optional existing Hugging Face cache; use absolute paths and forward slashes.
# HF_CACHE_PATH=C:/Users/your-user/.cache/huggingface
HF_HUB_OFFLINE=0

# To use an already-running model service instead of the GPU container:
# AI_SERVICE_URL=http://host.docker.internal:8002

# Optional Meta Muse credentials, passed only to backend.
MODEL_API_KEY=
META_MUSE_MODEL=muse-spark-1.3
